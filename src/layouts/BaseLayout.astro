---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Optional extra JSON-LD (e.g. Course or FAQPage) for this specific page. */
  jsonLd?: object | object[];
  /** Set true to keep this page out of search engines. */
  noindex?: boolean;
}

const {
  title = 'Direct Connect Flight Academy — Colorado Springs Flight School',
  description = "FAA Part 141 flight school in Colorado Springs with Examining Authority for Private and Instrument checkrides. Mentored by active airline pilots. Your airline career starts here.",
  jsonLd,
  noindex = false,
} = Astro.props;

// Site-wide organization / local-business structured data (helps local SEO + rich results).
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': ['EducationalOrganization', 'LocalBusiness'],
  name: site.name,
  alternateName: site.shortName,
  description: 'FAA Part 141 flight school in Colorado Springs, Colorado offering Private, Instrument, Commercial, Multi-Engine, ATP, ATP-CTP, and rotor-transition training.',
  url: Astro.site?.href,
  logo: Astro.site ? new URL('/images/logo/dcfa-logo.png', Astro.site).href : undefined,
  image: Astro.site ? new URL('/images/aircraft/da42-air.png', Astro.site).href : undefined,
  telephone: site.phone,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.state,
    postalCode: site.address.zip,
    addressCountry: 'US',
  },
  areaServed: { '@type': 'City', name: 'Colorado Springs' },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '09:00',
    closes: '17:00',
  },
  sameAs: [site.social.facebook, site.social.instagram, site.social.linkedin],
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={Astro.url.href} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <meta name="theme-color" content="#1e40af" />

  <!-- Open Graph (Facebook, iMessage, Slack, LinkedIn, Discord) -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={Astro.url.href} />
  <meta property="og:site_name" content="Direct Connect Flight Academy" />
  <meta property="og:image" content={new URL('/images/aircraft/da42-air.png', Astro.site).href} />
  <meta property="og:image:alt" content="DA42 multi-engine aircraft in flight — Direct Connect Flight Academy" />

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL('/images/aircraft/da42-air.png', Astro.site).href} />

  <!-- Structured data -->
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

  <script is:inline>
    (function () {
      try {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = stored || (prefersDark ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;
      } catch (e) {
        document.documentElement.dataset.theme = 'light';
      }
    })();
  </script>
</head>
<body class="bg-white text-slate-900 dark:bg-slate-950 dark:text-slate-100 flex flex-col min-h-screen transition-colors">
  <Header />
  <main class="flex-1">
    <slot />
  </main>
  <Footer />
</body>
</html>
