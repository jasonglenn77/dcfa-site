---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import CtaBlock from '../../components/ui/CtaBlock.astro';
import { vaBenefits } from '../../data/financing';
---
<BaseLayout
  title="VA Benefits & GI Bill — Direct Connect Flight Academy"
  description="DCFA accepts Chapter 30, 33, 1606, 1607 and VR&E (Chapter 31) benefits for four VA-approved programs. Step-by-step application guide for veterans."
>
  <PageHero
    eyebrow="For Veterans"
    title="VA benefits and the GI Bill®"
    subtitle="DCFA is approved by the Department of Veterans Affairs to train eligible veterans using GI Bill® and Veteran Readiness &amp; Employment (VR&amp;E) benefits. Here's exactly which benefits we accept, which four programs are approved, and how to apply."
  />

  <!-- Accepted chapters -->
  <section class="bg-white dark:bg-slate-950 py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16">
        <div>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">VA benefits we accept</h2>
          <ul class="mt-6 space-y-3">
            {vaBenefits.acceptedChapters.map(c => (
              <li class="rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 p-4 flex items-start gap-3">
                <div class="flex-shrink-0 h-8 w-8 rounded-md bg-green-100 dark:bg-green-900/40 flex items-center justify-center">
                  <svg class="h-4 w-4 text-green-700 dark:text-green-400" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                  </svg>
                </div>
                <div>
                  <div class="font-bold text-slate-900 dark:text-white">{c.code}</div>
                  <div class="text-sm text-slate-600 dark:text-slate-400">{c.name}</div>
                </div>
              </li>
            ))}
          </ul>
          <div class="mt-4 text-sm text-slate-600 dark:text-slate-400">
            Funding window: {vaBenefits.fundingWindow}.
          </div>
        </div>

        <div>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">VA-approved DCFA programs</h2>
          <ul class="mt-6 space-y-3">
            {vaBenefits.approvedPrograms.map(p => (
              <li class="rounded-lg border border-green-200 dark:border-green-900 bg-green-50 dark:bg-green-950/30 p-4 flex items-center justify-between">
                <span class="font-semibold text-slate-900 dark:text-white">{p}</span>
                <span class="text-xs font-semibold uppercase tracking-wide text-green-700 dark:text-green-400">Eligible</span>
              </li>
            ))}
            {vaBenefits.notEligible.map(p => (
              <li class="rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 p-4 flex items-center justify-between opacity-75">
                <span class="font-semibold text-slate-900 dark:text-white">{p}</span>
                <span class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Not Eligible</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Per-program VA detail -->
  <section class="bg-slate-50 dark:bg-slate-900 py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">VA-approved programs in detail</h2>
      <p class="mt-3 max-w-3xl text-base sm:text-lg text-slate-600 dark:text-slate-300">
        Each program below has its own VA-approved Training Course Outline. Every one also requires the following:
      </p>
      <ul class="mt-4 flex flex-wrap gap-2">
        {vaBenefits.commonEligibility.map(req => (
          <li class="rounded-full border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-3 py-1 text-sm text-slate-700 dark:text-slate-300">{req}</li>
        ))}
      </ul>

      <div class="mt-10 grid md:grid-cols-2 gap-5 sm:gap-6">
        {vaBenefits.programDetails.map(p => (
          <div class="flex flex-col rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 p-6">
            <div class="flex items-start justify-between gap-3">
              <h3 class="text-xl font-bold text-slate-900 dark:text-white">{p.name}</h3>
              <span class="flex-shrink-0 rounded-full bg-green-100 text-green-800 dark:bg-green-900/40 dark:text-green-300 px-3 py-1 text-xs font-semibold uppercase tracking-wide">Eligible</span>
            </div>
            <p class="mt-3 text-sm text-slate-700 dark:text-slate-300 leading-relaxed">{p.overview}</p>

            <div class="mt-4">
              <div class="text-xs font-semibold uppercase tracking-wide text-blue-700 dark:text-blue-400">Prerequisite</div>
              <div class="mt-1 text-sm text-slate-700 dark:text-slate-300">{p.prerequisite}</div>
            </div>

            <div class="mt-4">
              <div class="text-xs font-semibold uppercase tracking-wide text-blue-700 dark:text-blue-400">Aircraft &amp; training devices</div>
              <ul class="mt-1 space-y-1">
                {p.equipment.map(e => (
                  <li class="flex items-start gap-2 text-sm text-slate-700 dark:text-slate-300">
                    <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-blue-700 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                    <span>{e}</span>
                  </li>
                ))}
              </ul>
            </div>

            <a href={p.href} class="mt-5 inline-flex items-center text-sm font-semibold text-blue-700 dark:text-blue-400 hover:underline">
              See hours and pricing →
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Compliance notes -->
  <section class="bg-white dark:bg-slate-950 py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">What veterans should know</h2>
      <ul class="mt-8 grid gap-4 md:grid-cols-2">
        {vaBenefits.complianceNotes.map(note => (
          <li class="flex items-start gap-3 rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 p-5">
            <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-blue-700 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" /></svg>
            <span class="text-sm sm:text-base text-slate-700 dark:text-slate-300 leading-relaxed">{note}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Application steps -->
  <section class="bg-slate-50 dark:bg-slate-900 py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">How to apply</h2>
      <p class="mt-3 text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-2xl">
        Three steps. The first must be done with the VA before you start training.
      </p>

      <div class="mt-10 space-y-4 sm:space-y-6">
        {vaBenefits.applicationSteps.map((step, i) => (
          <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 p-5 sm:p-6 flex flex-col sm:flex-row gap-4 sm:gap-6">
            <div class="flex-shrink-0">
              <div class="h-12 w-12 rounded-full bg-blue-700 dark:bg-blue-600 text-white flex items-center justify-center font-extrabold text-lg">
                {i + 1}
              </div>
            </div>
            <div class="flex-1">
              <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white">{step.title}</h3>
              <p class="mt-2 text-slate-700 dark:text-slate-300">{step.detail}</p>
              {step.url && (
                <a href={step.url} target={step.url.startsWith('http') ? '_blank' : undefined} rel={step.url.startsWith('http') ? 'noopener' : undefined} class="mt-3 inline-flex items-center text-sm font-semibold text-blue-700 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300">
                  {step.url.startsWith('http') ? 'Open external link' : 'Submit interest form'} →
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- VA requires this attribution wherever the GI Bill trademark is used.
       https://www.benefits.va.gov/GIBILL/Trademark_Terms_of_Use.asp -->
  <section class="bg-slate-50 dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800 py-8">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="text-xs leading-relaxed text-slate-500 dark:text-slate-400">
        GI Bill® is a registered trademark of the U.S. Department of Veterans Affairs (VA). More information about
        education benefits offered by VA is available at the official U.S. government website at
        <a href="https://www.va.gov/education/" target="_blank" rel="noopener" class="underline hover:text-slate-700 dark:hover:text-slate-200">https://www.va.gov/education/</a>.
        DCFA is not affiliated with, endorsed by, or sponsored by the U.S. Department of Veterans Affairs.
      </p>
    </div>
  </section>

  <CtaBlock
    title="Ready to use your benefits?"
    description="Submit the contact form and we'll walk you through the COE, medical, and program-selection process."
    primaryHref="/contact"
    primaryLabel="Contact DCFA"
    secondaryLabel="Call (719) 208-7049"
  />
</BaseLayout>
