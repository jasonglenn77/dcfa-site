---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import CtaBlock from '../components/ui/CtaBlock.astro';
import partnersData from '../data/partners/partners.json';
import team from '../data/team/team.json';

// Partnerships are now editable in Tina (Collections <span class="cta-arrow">→</span> Partners).
const partnerships = partnersData.items;

// Initials fallback for team/grad photos that haven't been uploaded yet.
const avatarInitials = (name: string) =>
  name.split(/\s+/).filter(Boolean).slice(0, 2).map(w => w[0]).join('').toUpperCase();

// The team uses free-text fields as notes-to-self while drafting ("Ready for
// update", "need to fill this out", "TBD"). Treat those as empty so a placeholder
// never publishes as if it were real copy. Matches the whole trimmed value only,
// so a genuine bio that happens to contain one of these words is unaffected.
const PLACEHOLDER = /^(ready for update|need to fill (this )?out|tbd|todo|coming soon|placeholder|update|n\/a|-)?$/i;
const real = (v?: string) => (v && !PLACEHOLDER.test(v.trim()) ? v.trim() : '');

// Long bios are stored with \n paragraph breaks — split so they render as real
// paragraphs in the dialog instead of one run-on block.
const paragraphs = (v?: string) =>
  (v ?? '').split(/\n+/).map(s => s.trim()).filter(Boolean);

// Roles arrive comma-joined and inconsistently spaced
// ("Co-Founder,Vice President,Chief Flight Instructor"). Normalize to " · ".
const cleanRole = (v?: string) =>
  (v ?? '')
    .replace(/\bco-\s+founder\b/gi, 'Co-Founder') // fix "Co- Founder" typo
    .split(',')
    .map(s => s.trim())
    .filter(Boolean)
    .join(' · ');

// Normalize first, then decide what shows. A card needs a photo or a real bio;
// a role/name alone is not the credibility this section exists to provide.
const instructors = team.instructors
  .map(p => ({ ...p, role: cleanRole(p.role), bioText: real(p.bio), bioParas: paragraphs(real(p.bio)) }))
  .filter(p => p.photo || p.bioText);
const graduates = team.graduates
  .map(g => ({ ...g, bio: real(g.bio), achievement: real(g.achievement) }))
  .filter(g => g.photo || g.achievement || g.bio);
---
<BaseLayout
  title="About — Direct Connect Flight Academy"
  description="Direct Connect Flight Academy is an FAA Part 141 certificated flight school in Colorado Springs with Examining Authority for Private and Instrument checkrides."
>
  <PageHero
    eyebrow="About DCFA"
    title="Built by airline pilots, for future airline pilots."
    subtitle="Direct Connect Flight Academy was founded with one goal: train pilots the way airlines actually fly, so the transition from student to professional is as short and smooth as possible."
    bgImage="/images/team/open-house.jpg"
  />

  <!-- Examining Authority -->
  <section class="bg-white dark:bg-slate-950 py-16 sm:py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-10 lg:gap-16">
        <div class="lg:col-span-1">
          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 dark:text-white">FAA <span class="text-blue-700 dark:text-blue-400">Examining Authority</span></h2>
        </div>
        <div class="lg:col-span-2">
          <p class="text-base sm:text-lg text-slate-700 dark:text-slate-300 leading-relaxed">
            DCFA is one of only a small number of Part 141 schools in the United States to hold <strong>FAA Examining Authority</strong> for Private Pilot and Instrument Rating checkrides.
          </p>
          <p class="mt-4 text-base sm:text-lg text-slate-700 dark:text-slate-300 leading-relaxed">
            What that means in practice: when most students finish their training, they wait two to six weeks for a Designated Pilot Examiner (DPE) to be available for the checkride. During that wait, skills get rusty and timelines slip. At DCFA, we administer those checkrides ourselves, in-house, on our schedule. You finish when <em>you're</em> ready — not when an outside examiner has an opening.
          </p>
          <p class="mt-4 text-base sm:text-lg text-slate-700 dark:text-slate-300 leading-relaxed">
            That single advantage compresses the timeline from Discovery Flight to Commercial Pilot by months. It's the most concrete differentiator between DCFA and almost any other flight school you'll consider.
          </p>
          <p class="mt-6 text-sm text-slate-500 dark:text-slate-400 border-l-2 border-slate-200 dark:border-slate-700 pl-4 leading-relaxed">
            Examining Authority applies to eligible students enrolled in DCFA's FAA-approved Part 141 Private Pilot and Instrument Rating courses and is conducted in accordance with FAA regulations and DCFA's approved Training Course Outline.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Credentials -->
  <section class="bg-slate-50 dark:bg-slate-900 py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 dark:text-white">Credentials and capabilities</h2>

      <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
        {[
          { title: 'FAA Part 141 Certificated', body: 'Structured curriculum approved by the FAA, with reduced minimum hours compared to Part 61 training.' },
          { title: 'Examining Authority', body: 'In-house Private Pilot and Instrument checkrides. No DPE wait list.' },
          { title: 'Active Airline Pilot Mentors', body: 'Instructors are working Part 121 pilots, not time-builders. They know what comes next.' },
          { title: 'ATP-CTP with A320 Sim', body: 'Full-motion Airbus A320 simulator training in Dallas or Las Vegas as part of our $4,995 ATP-CTP program.' },
          { title: 'Rotor Transition Program', body: 'Customized fixed-wing pathways for military and civilian helicopter pilots.' },
          { title: 'VA Benefits Accepted', body: 'Chapters 30, 33, 1606, 1607 and VR&E (Chapter 31) across four approved programs.' },
        ].map(c => (
          <div class="rounded-lg bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 p-5 sm:p-6">
            <h3 class="text-lg font-bold text-slate-900 dark:text-white">{c.title}</h3>
            <p class="mt-2 text-sm sm:text-base text-slate-700 dark:text-slate-300">{c.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Meet the team -->
  {instructors.length > 0 && (
  <section class="bg-white dark:bg-slate-950 py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 dark:text-white">Meet the team.</h2>
        <p class="mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-300">The instructors and staff who'll get you to the flight deck.</p>
      </div>
      <div class="mt-10 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-6 sm:gap-8" data-team-grid>
        {instructors.map((person) => (
          <div class="team-card text-center" data-team-card>
            <div class="team-head">
              <div class="team-photo mx-auto aspect-square w-full rounded-xl overflow-hidden bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center">
                {person.photo ? (
                  <img src={person.photo} alt={person.name} class="w-full h-full object-cover" loading="lazy" />
                ) : (
                  <span class="text-3xl font-extrabold text-slate-400 dark:text-slate-500">{avatarInitials(person.name)}</span>
                )}
              </div>
              <div class="team-meta">
                <h3 class="team-name mt-3 font-bold text-slate-900 dark:text-white">{person.name}</h3>
                {person.role && <div class="text-sm text-blue-700 dark:text-blue-400">{person.role}</div>}
                {person.bioParas.length > 0 && (
                  <button type="button" data-bio-toggle aria-expanded="false" class="mt-2 inline-flex items-center gap-1 text-sm font-semibold text-blue-700 dark:text-blue-400 hover:underline">
                    <span class="toggle-label">Read bio</span>
                    <svg class="toggle-chevron h-3.5 w-3.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
                  </button>
                )}
              </div>
            </div>
            {person.bioParas.length > 0 && (
              <div class="team-bio text-left text-[15px] leading-relaxed text-slate-700 dark:text-slate-300 space-y-3">
                {person.bioParas.map(para => <p>{para}</p>)}
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
  )}

  <!-- Graduate spotlights -->
  {graduates.length > 0 && (
  <section class="bg-slate-50 dark:bg-slate-900 py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 dark:text-white">Graduate spotlights.</h2>
        <p class="mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-300">DCFA graduates building real aviation careers.</p>
      </div>
      <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
        {graduates.map(grad => (
          <div class="flex gap-4 rounded-xl bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 p-5">
            <div class="flex-shrink-0 h-16 w-16 rounded-full overflow-hidden bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center">
              {grad.photo ? (
                <img src={grad.photo} alt={grad.name} class="w-full h-full object-cover" loading="lazy" />
              ) : (
                <span class="text-lg font-extrabold text-slate-400 dark:text-slate-500">{avatarInitials(grad.name)}</span>
              )}
            </div>
            <div class="min-w-0">
              <h3 class="font-bold text-slate-900 dark:text-white">{grad.name}</h3>
              {grad.achievement && <div class="text-sm text-blue-700 dark:text-blue-400">{grad.achievement}</div>}
              {grad.bio && <p class="mt-1 text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{grad.bio}</p>}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
  )}

  <!-- Partnerships in action -->
  <section class="bg-white dark:bg-slate-950 py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 dark:text-white">Partnerships <span class="text-blue-700 dark:text-blue-400">in action.</span></h2>
        <p class="mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-300">
          Established pipelines to the flight deck — not just logos on a page, but real working relationships with carriers actively hiring our graduates.
        </p>
      </div>

      <div class="mt-10 grid sm:grid-cols-2 gap-6 lg:gap-8">
        {partnerships.map(p => (
          <article class="flex flex-col rounded-xl overflow-hidden border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900">
            <div class="flex items-center justify-center h-28 bg-white border-b border-slate-200 dark:border-slate-800 px-6">
              {p.logo ? (
                <img src={p.logo} alt={`${p.name} logo`} class="max-h-14 w-auto object-contain" loading="lazy" />
              ) : (
                <span class="text-2xl sm:text-3xl font-bold tracking-tight text-red-700">{p.wordmark ?? p.name}</span>
              )}
            </div>
            <div class="flex flex-col flex-1 p-6 sm:p-7">
              <div class="text-xs font-semibold tracking-wide text-blue-700 dark:text-blue-400 uppercase">{p.meta}</div>
              <h3 class="mt-2 text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white">{p.name}</h3>
              <p class="mt-3 text-slate-700 dark:text-slate-300 flex-1">{p.blurb}</p>
              {p.url && (
                <a href={p.url} target="_blank" rel="noopener" class="mt-4 inline-flex items-center self-start text-sm font-semibold text-blue-700 dark:text-blue-400 hover:underline">
                  Visit {p.name} <span class="cta-arrow">→</span>
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Location advantage -->
  <section class="bg-white dark:bg-slate-950 py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
        <div>
          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 dark:text-white">Meadow Lake Airport <span class="text-blue-700 dark:text-blue-400">(KFLY)</span></h2>
          <p class="mt-4 text-base sm:text-lg text-slate-700 dark:text-slate-300 leading-relaxed">
            Based at Meadow Lake Airport (KFLY) in Peyton — part of the greater Colorado Springs area — where we benefit from over <strong>300 days of flying weather per year</strong>, true high-altitude operations, and quick access to the Front Range and nearby Class C airspace — the kind of varied training environment that produces well-rounded pilots.
          </p>
          <div class="mt-6 rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 p-5">
            <div class="font-semibold text-slate-900 dark:text-white">13775 Judge Orr Rd</div>
            <div class="text-slate-700 dark:text-slate-300">Peyton, CO 80831</div>
          </div>
        </div>
        <div>
          <div class="aspect-[4/3] rounded-xl overflow-hidden bg-slate-100 dark:bg-slate-800">
            <img src="/images/aircraft/da42-ground.png" alt="DA-42 twin-engine aircraft at Meadow Lake Airport" class="w-full h-full object-cover" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <CtaBlock />

  <style>
    /* Bios expand inline instead of in a modal. Closed = a centred headshot
       card; open = the card spans the full grid width and lays the photo beside
       the name/role with the bio below. One card open at a time (handled in JS). */
    .team-bio { display: none; }
    .team-card.is-open {
      grid-column: 1 / -1;
      text-align: left;
      border: 1px solid rgb(226 232 240);
      border-radius: 0.75rem;
      background: rgb(248 250 252);
      padding: 1.5rem;
    }
    :global([data-theme="dark"]) .team-card.is-open {
      border-color: rgb(30 41 59);
      background: rgb(15 23 42);
    }
    .team-card.is-open .team-head { display: flex; align-items: center; gap: 1.25rem; }
    .team-card.is-open .team-photo { width: 6rem; height: 6rem; margin: 0; flex: 0 0 auto; }
    @media (min-width: 640px) {
      .team-card.is-open .team-photo { width: 7rem; height: 7rem; }
    }
    .team-card.is-open .team-name { margin-top: 0; }
    .team-card.is-open .team-bio { display: block; margin-top: 1.25rem; }
    .team-card.is-open .toggle-chevron { transform: rotate(180deg); }
  </style>

  <script>
    // Team bios expand inline (one open at a time) rather than opening a modal.
    const grid = document.querySelector('[data-team-grid]');
    if (grid) {
      grid.querySelectorAll('[data-bio-toggle]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const card = btn.closest('[data-team-card]');
          if (!card) return;
          const willOpen = !card.classList.contains('is-open');
          // Collapse whatever is open first.
          grid.querySelectorAll('[data-team-card].is-open').forEach((c) => {
            c.classList.remove('is-open');
            const b = c.querySelector('[data-bio-toggle]');
            if (b) {
              b.setAttribute('aria-expanded', 'false');
              const l = b.querySelector('.toggle-label');
              if (l) l.textContent = 'Read bio';
            }
          });
          if (willOpen) {
            card.classList.add('is-open');
            btn.setAttribute('aria-expanded', 'true');
            const l = btn.querySelector('.toggle-label');
            if (l) l.textContent = 'Hide bio';
          }
        });
      });
    }
  </script>
</BaseLayout>
