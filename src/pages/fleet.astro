---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import CtaBlock from '../components/ui/CtaBlock.astro';
import fleet from '../data/fleet/fleet.json';

// Drop blank spec entries — a stray empty line from a Tina edit would otherwise
// render as a bullet with no text. Normalize here so every render site is safe.
const aircraft = fleet.aircraft.map(ac => ({
  ...ac,
  specs: (ac.specs ?? []).map(s => s.trim()).filter(Boolean),
}));
const instructionRate = fleet.instructionRate;
const simulator = {
  ...fleet.simulator,
  specs: (fleet.simulator?.specs ?? []).map(s => s.trim()).filter(Boolean),
};
---
<BaseLayout
  title="Aircraft Fleet & Rates — Direct Connect Flight Academy"
  description="DCFA fleet of single- and multi-engine training aircraft. Hourly rental rates for academy graduates and enrolled students. Instruction at $70/hr."
>
  <PageHero
    eyebrow="Our Aircraft"
    title="Fleet and rental rates"
    subtitle="Single- and multi-engine training aircraft, all available to enrolled students and DCFA graduates after the Transition Course. Rates listed are wet, per flight hour."
    bgImage="/images/aircraft/da42-air.png"
  />

  <!-- Aircraft list -->
  <section class="bg-white dark:bg-slate-950 py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">The fleet</h2>

      <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
        {aircraft.map(ac => (
          <div class="group relative flex flex-col overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
            <div class="relative aspect-[4/3] bg-slate-100 dark:bg-slate-800">
              {ac.photo ? (
                <img src={ac.photo} alt={`${ac.tailNumber} — ${ac.makeModel || ac.type}`} class="absolute inset-0 h-full w-full object-cover" loading="lazy" />
              ) : (
                <div class="flex h-full w-full items-center justify-center text-slate-300 dark:text-slate-600">
                  <svg class="h-16 w-16" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5" /></svg>
                </div>
              )}
              {ac.specs && ac.specs.length > 0 && (
                <div data-specs class="absolute inset-0 flex flex-col justify-start overflow-y-auto bg-slate-950/90 p-5 text-white opacity-0 transition-opacity duration-300 hoverable:group-hover:opacity-100">
                  <div class="text-xs font-semibold uppercase tracking-wide text-blue-300">Aircraft details</div>
                  <ul class="mt-3 space-y-1.5">
                    {ac.specs.map(s => (
                      <li class="flex items-start gap-2 text-sm">
                        <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-blue-300" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                        <span>{s}</span>
                      </li>
                    ))}
                  </ul>
                  {ac.description && <p class="mt-3 text-sm text-slate-200">{ac.description}</p>}
                </div>
              )}
            </div>
            <div class="flex flex-1 flex-col p-5 sm:p-6">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <div class="text-xs font-semibold tracking-wide uppercase text-blue-700 dark:text-blue-400">{ac.type}</div>
                  <div class="mt-1 text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white">{ac.makeModel || ac.tailNumber}</div>
                  {ac.makeModel && <div class="text-sm font-mono text-slate-500 dark:text-slate-400">{ac.tailNumber}</div>}
                </div>
                <div class="flex-shrink-0 text-right">
                  <div class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white">${ac.hourlyRate}</div>
                  <div class="text-xs text-slate-500 dark:text-slate-400">/hr, wet</div>
                </div>
              </div>
              {ac.specs && ac.specs.length > 0 && (
                <button type="button" data-specs-toggle aria-expanded="false" class="mt-4 -mx-2 self-start px-2 py-3 text-sm font-semibold text-blue-700 dark:text-blue-400 hover:underline hoverable:hidden">View aircraft details →</button>
              )}
            </div>
          </div>
        ))}
      </div>

      <!-- Wide banner: training in action -->
      <figure class="mt-10 rounded-xl overflow-hidden border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-900">
        <div class="aspect-[21/9] sm:aspect-[3/1]">
          <img src="/images/aircraft/multi-engine.jpg" alt="DCFA multi-engine training in progress" class="w-full h-full object-cover" loading="lazy" />
        </div>
        <figcaption class="px-5 py-4 text-sm text-slate-600 dark:text-slate-400 border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950">
          <span class="font-semibold text-slate-900 dark:text-white">Multi-engine training</span> — every commercial pilot and ATP candidate spends real hours in the twin.
        </figcaption>
      </figure>

      <!-- Instruction rate + rules -->
      <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="rounded-xl bg-blue-50 dark:bg-blue-950/30 border border-blue-200 dark:border-blue-900 p-6 sm:p-8">
          <div class="text-xs font-semibold tracking-wide uppercase text-blue-700 dark:text-blue-400">Flight Instruction</div>
          <div class="mt-2 text-4xl sm:text-5xl font-extrabold text-slate-900 dark:text-white">${instructionRate}<span class="text-2xl text-slate-500 dark:text-slate-400 font-normal">/hr</span></div>
          <div class="mt-2 text-sm text-slate-700 dark:text-slate-300">Applies to CFI, CFII &amp; MEI, in addition to aircraft rental.</div>
        </div>
        <div class="rounded-xl bg-blue-50 dark:bg-blue-950/30 border border-blue-200 dark:border-blue-900 p-6 sm:p-8">
          <div class="text-xs font-semibold tracking-wide uppercase text-blue-700 dark:text-blue-400">{simulator.name}</div>
          <div class="mt-2 text-4xl sm:text-5xl font-extrabold text-slate-900 dark:text-white">${simulator.hourlyRate}<span class="text-2xl text-slate-500 dark:text-slate-400 font-normal">/hr</span></div>
          {simulator.note && <div class="mt-2 text-sm text-slate-700 dark:text-slate-300">{simulator.note}</div>}
          {simulator.specs && simulator.specs.length > 0 && (
            <ul class="mt-4 space-y-1.5 border-t border-blue-200 dark:border-blue-900 pt-4">
              {simulator.specs.map(s => (
                <li class="flex items-start gap-2 text-sm text-slate-700 dark:text-slate-300">
                  <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-blue-700 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                  <span>{s}</span>
                </li>
              ))}
            </ul>
          )}
        </div>
        <div class="rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-6 sm:p-8">
          <div class="text-xs font-semibold tracking-wide uppercase text-slate-500 dark:text-slate-400">Rental Eligibility</div>
          <div class="mt-2 text-base sm:text-lg font-semibold text-slate-900 dark:text-white">Academy graduates and enrolled students only</div>
          <div class="mt-2 text-sm text-slate-700 dark:text-slate-300">Transition Course completion is required before any aircraft rental. Renter's insurance is also required — see our <a href="/insurance" class="font-semibold text-blue-700 dark:text-blue-400 hover:underline">insurance requirements</a>.</div>
        </div>
      </div>
    </div>
  </section>

  <CtaBlock
    title="Want to fly?"
    description="Whether you're starting from zero or returning to the cockpit, we can get you behind the yoke."
    primaryLabel="Book a Discovery Flight — $150"
    secondaryLabel="Call (719) 208-7049"
  />

  <script>
    // Touch devices: tap to reveal the aircraft-details overlay. Hover-capable
    // pointers get it via the `hoverable:group-hover` variant instead, so the two
    // mechanisms never fight over the same element.
    document.querySelectorAll('[data-specs-toggle]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const panel = btn.closest('.group')?.querySelector('[data-specs]');
        if (!panel) return;
        const open = panel.style.opacity !== '1';
        panel.style.opacity = open ? '1' : '';
        btn.setAttribute('aria-expanded', String(open));
        btn.textContent = open ? 'Hide aircraft details ←' : 'View aircraft details →';
      });
    });
  </script>
</BaseLayout>
