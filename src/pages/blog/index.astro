---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout
  title="Blog — Direct Connect Flight Academy"
  description="News, training tips, and aviation industry insights from Direct Connect Flight Academy in Colorado Springs."
>
  <PageHero
    eyebrow="News & Insights"
    title="The DCFA Blog"
    subtitle="Academy news, training tips, and what's happening in the aviation industry — from our flight line to your inbox."
  />

  <section class="bg-white dark:bg-slate-950 py-16 sm:py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      {posts.length === 0 ? (
        <p class="text-lg text-slate-600 dark:text-slate-300">No posts yet — check back soon.</p>
      ) : (
        <div class="grid gap-8 sm:grid-cols-2">
          {posts.map(post => (
            <article class="flex flex-col rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 overflow-hidden">
              {post.data.heroImage && (
                <a href={`/blog/${post.id}`} class="block aspect-[16/9] bg-slate-100 dark:bg-slate-800 overflow-hidden">
                  <img src={post.data.heroImage} alt="" class="w-full h-full object-cover transition duration-500 hover:scale-105" loading="lazy" />
                </a>
              )}
              <div class="flex flex-col flex-1 p-6">
                <div class="text-xs font-semibold uppercase tracking-wide text-blue-700 dark:text-blue-400">{fmt(post.data.pubDate)}</div>
                <h2 class="mt-2 text-xl font-extrabold tracking-tight text-slate-900 dark:text-white">
                  <a href={`/blog/${post.id}`} class="hover:text-blue-700 dark:hover:text-blue-400 transition">{post.data.title}</a>
                </h2>
                <p class="mt-3 text-slate-700 dark:text-slate-300 flex-1">{post.data.description}</p>
                <a href={`/blog/${post.id}`} class="mt-4 inline-flex items-center self-start text-sm font-semibold text-blue-700 dark:text-blue-400 hover:underline">Read more →</a>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
