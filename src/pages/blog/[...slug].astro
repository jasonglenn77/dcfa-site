---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBlock from '../../components/ui/CtaBlock.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout title={`${post.data.title} — Direct Connect Flight Academy`} description={post.data.description}>
  <article class="bg-white dark:bg-slate-950">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
      <a href="/blog" class="text-sm font-semibold text-blue-700 dark:text-blue-400 hover:underline">← Back to blog</a>

      <div class="mt-6 text-xs font-semibold uppercase tracking-wide text-blue-700 dark:text-blue-400">
        {fmt(post.data.pubDate)} · {post.data.author}
      </div>
      <h1 class="mt-3 text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">{post.data.title}</h1>
      <p class="mt-4 text-lg text-slate-600 dark:text-slate-300">{post.data.description}</p>

      {post.data.heroImage && (
        <img src={post.data.heroImage} alt="" class="mt-8 w-full rounded-xl border border-slate-200 dark:border-slate-800" />
      )}

      <div class="post-body mt-10">
        <Content />
      </div>
    </div>
  </article>

  <CtaBlock
    title="Ready to start your training?"
    description="A Discovery Flight is the best way to find out if aviation is for you."
    primaryLabel="Book a Discovery Flight — $150"
    secondaryLabel="Call (719) 208-7049"
  />
</BaseLayout>

<style is:global>
  .post-body { color: rgb(51 65 85); line-height: 1.75; font-size: 1.0625rem; }
  [data-theme="dark"] .post-body { color: rgb(203 213 225); }
  .post-body > :first-child { margin-top: 0; }
  .post-body h2 { margin-top: 2rem; margin-bottom: 0.75rem; font-size: 1.5rem; font-weight: 800; letter-spacing: -0.01em; color: rgb(15 23 42); }
  [data-theme="dark"] .post-body h2 { color: rgb(255 255 255); }
  .post-body h3 { margin-top: 1.5rem; margin-bottom: 0.5rem; font-size: 1.25rem; font-weight: 700; color: rgb(15 23 42); }
  [data-theme="dark"] .post-body h3 { color: rgb(241 245 249); }
  .post-body p { margin-bottom: 1.25rem; }
  .post-body ul, .post-body ol { margin: 1.25rem 0; padding-left: 1.5rem; }
  .post-body ul { list-style: disc; }
  .post-body ol { list-style: decimal; }
  .post-body li { margin-bottom: 0.5rem; }
  .post-body a { color: rgb(29 78 216); font-weight: 600; text-decoration: underline; }
  [data-theme="dark"] .post-body a { color: rgb(96 165 250); }
  .post-body strong { color: rgb(15 23 42); font-weight: 700; }
  [data-theme="dark"] .post-body strong { color: rgb(241 245 249); }
  .post-body blockquote { border-left: 4px solid rgb(29 78 216); padding-left: 1rem; font-style: italic; color: rgb(71 85 105); margin: 1.5rem 0; }
  [data-theme="dark"] .post-body blockquote { color: rgb(148 163 184); }
  .post-body img { border-radius: 0.5rem; margin: 1.5rem 0; }
  .post-body hr { border: 0; border-top: 1px solid rgb(226 232 240); margin: 2rem 0; }
  [data-theme="dark"] .post-body hr { border-color: rgb(30 41 59); }
</style>
