---
import BaseLayout from '../layouts/BaseLayout.astro';
import home from '../data/home/home.json';
import partnersData from '../data/partners/partners.json';
import reviewsData from '../data/reviews/reviews.json';
import { vaBenefits } from '../data/financing';
import { programs as allPrograms } from '../data/programs';

// Derived from programs.ts so prices and #anchors can never drift from /training.
// The anchor must match ProgramCard's `id={program.slug}`.
const programCards = [
  ...allPrograms
    .filter(p => p.slug !== 'transition-course')
    .map(p => ({
      name: p.name,
      price: p.price,
      hours: `${p.totalFlightHours} flight hrs`,
      href: `/training#${p.slug}`,
    })),
  // ATP-CTP lives on its own page, not in programs.ts.
  { name: 'ATP-CTP', price: '$4,995', hours: '40 hrs total', href: '/atp-ctp' },
];

// Airline partners shown in the home page logo strip (editable in Tina <span class="cta-arrow">→</span> Partners).
const airlinePartners = partnersData.items.filter(p => p.airlinePartner && p.logo);

// Curated reviews (editable in Tina <span class="cta-arrow">→</span> Reviews). Section hides until populated.
const reviews = reviewsData.items.filter(r => r.text);

// Social profiles. TikTok appears once a URL is added below.
const socials = [
  { label: 'Instagram', url: 'https://www.instagram.com/flydcfa/', icon: 'M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z' },
  { label: 'Facebook', url: 'https://www.facebook.com/p/Direct-Connect-Flight-Academy-100063680315409/', icon: 'M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z' },
  { label: 'TikTok', url: 'https://www.tiktok.com/@flydcfa', icon: 'M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z' },
].filter(s => s.url);
---
<BaseLayout>
  <!-- Hero carousel -->
  <section class="relative overflow-hidden bg-slate-900">
    <div class="absolute inset-0">
      {home.heroImages.map((img, i) => (
        <img
          src={img.image}
          alt=""
          class:list={["hero-slide absolute inset-0 h-full w-full object-cover brightness-110 transition-opacity duration-1000 ease-in-out", i === 0 ? "opacity-100" : "opacity-0"]}
          loading={i === 0 ? "eager" : "lazy"}
        />
      ))}
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/75 via-slate-950/50 to-slate-950/35 sm:bg-gradient-to-r sm:from-slate-950/80 sm:via-slate-950/45 sm:to-slate-950/20"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/45 to-transparent"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-24 lg:py-32">
      <div class="max-w-3xl">
        <div class="flex flex-wrap items-center gap-2">
          <div class="inline-flex items-center rounded-full border border-white/25 bg-white/10 px-3.5 py-1 text-xs font-semibold tracking-wider text-white uppercase backdrop-blur">
            FAA Part 141 Certificated · Colorado Springs
          </div>
          <a href="#veterans" class="inline-flex items-center gap-1.5 rounded-full border border-green-300/40 bg-green-400/15 px-3 py-1 text-xs font-semibold tracking-wide text-green-100 uppercase backdrop-blur transition hover:bg-green-400/25">
            <svg class="h-3 w-3" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2 3 6v6c0 5.25 3.75 9.75 9 10 5.25-.25 9-4.75 9-10V6l-9-4Z" /></svg>
            VA Approved · GI Bill Accepted
          </a>
        </div>

        <h1 class="mt-6 text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.05] text-white">
          Your airline career,<br />
          <span class="text-blue-400">on your schedule.</span>
        </h1>

        <p class="mt-6 text-lg sm:text-xl text-slate-100 leading-relaxed max-w-2xl">
          Direct Connect Flight Academy is one of only a handful of flight schools in the United States with
          <strong class="text-white">FAA Examining Authority</strong> for Private and Instrument checkrides.
          We administer your checkrides in-house — so you finish when you're ready, not when an outside examiner is available.
        </p>

        <div class="mt-10 flex flex-wrap gap-4">
          <a href="/contact?program=Discovery%20Flight" class="inline-flex items-center rounded-md bg-blue-600 hover:bg-blue-700 px-6 py-3 text-base font-semibold text-white transition shadow-lg shadow-blue-900/40">
            Book a Discovery Flight — $150
          </a>
          <a href="/training" class="inline-flex items-center rounded-md border border-white/40 bg-white/10 backdrop-blur px-6 py-3 text-base font-semibold text-white hover:bg-white/20 transition">
            Explore Programs <span class="cta-arrow">→</span>
          </a>
        </div>
      </div>

      <!-- Stats strip -->
      <div class="mt-16 grid grid-cols-1 sm:grid-cols-3 overflow-hidden rounded-lg border border-white/15 bg-white/10 max-w-3xl backdrop-blur">
        <div class="px-6 py-6">
          <div class="font-display text-4xl sm:text-5xl font-bold leading-none text-white tabular-nums">300+</div>
          <div class="mt-2 text-sm text-slate-200">flying days per year</div>
        </div>
        <div class="px-6 py-6 border-t sm:border-t-0 sm:border-l border-white/15">
          <div class="font-display text-4xl sm:text-5xl font-bold leading-none text-white">141</div>
          <div class="mt-2 text-sm text-slate-200">FAA Part 141 certificated</div>
        </div>
        <div class="px-6 py-6 border-t sm:border-t-0 sm:border-l border-white/15">
          <div class="font-display text-3xl sm:text-4xl font-bold leading-none text-white">In-house</div>
          <div class="mt-2 text-sm text-slate-200">Private &amp; Instrument checkrides</div>
        </div>
      </div>
    </div>

    {home.heroImages.length > 1 && (
      <!-- Dot is 10px but the button is padded out to a 44px tap target. -->
      <div id="hero-dots" class="absolute bottom-2 left-1/2 z-10 flex -translate-x-1/2">
        {home.heroImages.map((_, i) => (
          <button type="button" data-slide={i} aria-label={`Show slide ${i + 1}`} class="group flex h-11 w-11 items-center justify-center">
            <span class:list={["block h-2.5 w-2.5 rounded-full transition", i === 0 ? "bg-white" : "bg-white/40 group-hover:bg-white/70"]}></span>
          </button>
        ))}
      </div>
    )}
  </section>

  <script>
    (function () {
      const slides = Array.from(document.querySelectorAll('.hero-slide'));
      const dots = Array.from(document.querySelectorAll('#hero-dots button'));
      if (slides.length < 2) return;
      let idx = 0;
      function show(n) {
        idx = (n + slides.length) % slides.length;
        slides.forEach((s, i) => { s.style.opacity = i === idx ? '1' : '0'; });
        dots.forEach((d, i) => {
          // The colour lives on the inner span; the button is just the tap target.
          const dot = d.firstElementChild;
          if (!dot) return;
          dot.classList.toggle('bg-white', i === idx);
          dot.classList.toggle('bg-white/40', i !== idx);
        });
      }
      let timer = setInterval(() => show(idx + 1), 5500);
      dots.forEach((d) => d.addEventListener('click', () => {
        show(Number(d.dataset.slide));
        clearInterval(timer);
        timer = setInterval(() => show(idx + 1), 5500);
      }));
    })();
  </script>

  <!-- Why Examining Authority matters -->
  <section class="bg-white dark:bg-slate-950 py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div>
          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 dark:text-white">
            Why <span class="text-blue-700 dark:text-blue-400">Examining Authority</span> changes everything.
          </h2>
          <p class="mt-6 text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
            At most flight schools, when you're ready for your Private or Instrument checkride, you wait. You wait two weeks. You wait six weeks.
            You wait for a Designated Pilot Examiner (DPE) to have an open slot — and during that wait, your skills get rusty and your timeline slips.
          </p>
          <p class="mt-4 text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
            DCFA holds <strong class="text-slate-900 dark:text-white">FAA Examining Authority</strong>, granted to only a small number of Part 141 schools nationwide.
            That means we conduct your Private and Instrument checkrides in-house, on our schedule, when <em>you're</em> ready.
            No DPE wait list. No skill decay. You move from rating to rating without losing momentum.
          </p>
          <a href="/about" class="mt-8 inline-flex items-center text-sm font-semibold text-blue-700 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300">
            Learn more about our credentials <span class="cta-arrow">→</span>
          </a>
        </div>

        <div class="grid gap-4">
          <div class="rounded-lg border border-slate-200 dark:border-slate-800 p-6 bg-slate-50 dark:bg-slate-900">
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 font-display text-3xl font-bold leading-none text-blue-700 dark:text-blue-400 tabular-nums">01</div>
              <div>
                <div class="font-semibold text-slate-900 dark:text-white">Finish on schedule</div>
                <div class="text-sm text-slate-600 dark:text-slate-400 mt-1">No 2–6 week wait between training completion and checkride.</div>
              </div>
            </div>
          </div>
          <div class="rounded-lg border border-slate-200 dark:border-slate-800 p-6 bg-slate-50 dark:bg-slate-900">
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 font-display text-3xl font-bold leading-none text-blue-700 dark:text-blue-400 tabular-nums">02</div>
              <div>
                <div class="font-semibold text-slate-900 dark:text-white">Examined by your mentors</div>
                <div class="text-sm text-slate-600 dark:text-slate-400 mt-1">Active airline pilots who know exactly what professional standards look like.</div>
              </div>
            </div>
          </div>
          <div class="rounded-lg border border-slate-200 dark:border-slate-800 p-6 bg-slate-50 dark:bg-slate-900">
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 font-display text-3xl font-bold leading-none text-blue-700 dark:text-blue-400 tabular-nums">03</div>
              <div>
                <div class="font-semibold text-slate-900 dark:text-white">Accelerated pathways</div>
                <div class="text-sm text-slate-600 dark:text-slate-400 mt-1">Zero-to-Commercial in 12–14 months. Instrument-to-Commercial in 9–11 months.</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Veterans / VA benefits (anchored from the hero chip) -->
  <section id="veterans" class="scroll-mt-20 bg-gradient-to-br from-blue-800 to-blue-950 dark:from-slate-900 dark:to-slate-950 text-white py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
        <div>
          <div class="text-xs font-semibold tracking-wide uppercase text-blue-300">For Veterans</div>
          <h2 class="mt-3 text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight">
            We love our <span class="text-blue-300">VETERANS!</span>
          </h2>
          <div class="mt-3 text-xl sm:text-2xl font-bold text-blue-100">VA benefits and the GI Bill</div>
          <p class="mt-4 text-base sm:text-lg text-blue-100 leading-relaxed max-w-xl">
            DCFA is approved by the Department of Veterans Affairs to train eligible veterans using
            GI Bill&reg; and Veteran Readiness &amp; Employment (VR&amp;E) benefits &mdash; across four approved programs.
            Here's exactly which benefits we accept, which programs are eligible, and how to apply.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/financing/va-benefits" class="inline-flex items-center rounded-md bg-white text-blue-900 px-6 py-3 text-base font-semibold hover:bg-blue-50 transition">
              See the VA benefits guide <span class="cta-arrow">→</span>
            </a>
            <a href="/contact?program=Unsure%20%2F%20want%20to%20learn%20more" class="inline-flex items-center rounded-md border border-white/30 px-6 py-3 text-base font-semibold text-white hover:bg-white/10 transition">
              Talk to us
            </a>
          </div>
        </div>

        <div class="rounded-xl bg-white/10 backdrop-blur border border-white/20 p-6 sm:p-8">
          <div class="text-sm font-semibold uppercase tracking-wide text-blue-200">VA benefits we accept</div>
          <ul class="mt-4 grid sm:grid-cols-2 gap-3">
            {vaBenefits.acceptedChapters.map(c => (
              <li class="rounded-lg bg-white/10 border border-white/15 p-4">
                <div class="font-bold text-white">{c.code}</div>
                <div class="mt-0.5 text-xs text-blue-200">{c.name}</div>
              </li>
            ))}
          </ul>
          <div class="mt-4 text-sm text-blue-200">
            Funding window: {vaBenefits.fundingWindow}.
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Programs preview with pricing transparency -->
  <section class="bg-slate-50 dark:bg-slate-900 py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-12">
        <div>
          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 dark:text-white">Every certificate. Every rating. <span class="text-blue-700 dark:text-blue-400">Transparent pricing.</span></h2>
        </div>
        <a href="/training" class="text-sm font-semibold text-blue-700 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300">View all programs <span class="cta-arrow">→</span></a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {programCards.map(program => (
          <a href={program.href} class="group block rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 p-6 hover:border-blue-500 dark:hover:border-blue-500 hover:shadow-lg transition">
            <div class="text-sm text-slate-500 dark:text-slate-400">{program.hours}</div>
            <div class="mt-1 text-xl font-bold text-slate-900 dark:text-white group-hover:text-blue-700 dark:group-hover:text-blue-400 transition">{program.name}</div>
            <div class="mt-4 flex items-end justify-between">
              <div class="text-2xl font-extrabold text-slate-900 dark:text-white">{program.price}</div>
              <div class="text-blue-600 dark:text-blue-400 group-hover:translate-x-1 transition">→</div>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-10 rounded-lg bg-blue-900 dark:bg-blue-950 text-white p-6 sm:p-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
        <div>
          <div class="font-bold text-lg">Need a custom training plan?</div>
          <div class="text-blue-100 text-sm mt-1">Rotor pilots, returning students, and veterans all have unique paths. Tell us where you are — we'll build the right program.</div>
        </div>
        <a href="/contact?program=Unsure%20%2F%20want%20to%20learn%20more" class="flex-shrink-0 inline-flex items-center rounded-md bg-white text-blue-900 px-5 py-2.5 text-sm font-semibold hover:bg-blue-50 transition">
          Get a personalized quote
        </a>
      </div>
    </div>
  </section>

  <!-- Differentiators -->
  <section class="bg-white dark:bg-slate-950 py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto">
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 dark:text-white">Trained the way <span class="text-blue-700 dark:text-blue-400">airlines</span> actually fly.</h2>
        <p class="mt-4 text-lg text-slate-600 dark:text-slate-300">From your first flight, you'll learn crew concepts, checklist discipline, and Line-Oriented Scenarios — the same techniques used by Part 121 carriers.</p>
      </div>

      <div class="mt-14 grid grid-cols-1 md:grid-cols-3 gap-8 sm:gap-10">
        <div class="border-t-2 border-blue-700 dark:border-blue-500 pt-5">
          <h3 class="text-lg font-bold text-slate-900 dark:text-white">Multi-crew from day one</h3>
          <p class="mt-2 text-slate-600 dark:text-slate-400">Challenge-response checklists, crew callouts, and CRM are baked into Lesson 1 — not added on later.</p>
        </div>

        <div class="border-t-2 border-blue-700 dark:border-blue-500 pt-5">
          <h3 class="text-lg font-bold text-slate-900 dark:text-white">Mentored by airline pilots</h3>
          <p class="mt-2 text-slate-600 dark:text-slate-400">Our instructors aren't time-builders — they're active Part 121 pilots who know what comes next in your career.</p>
        </div>

        <div class="border-t-2 border-blue-700 dark:border-blue-500 pt-5">
          <h3 class="text-lg font-bold text-slate-900 dark:text-white">Examining Authority</h3>
          <p class="mt-2 text-slate-600 dark:text-slate-400">In-house Private and Instrument checkrides. Skip the DPE wait. Finish on time, every time.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- DCFA in action: photo gallery -->
  <section class="bg-white dark:bg-slate-950 py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto">
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 dark:text-white">From the cockpit to <span class="text-blue-700 dark:text-blue-400">airline partnerships.</span></h2>
        <p class="mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-300">Real students, real instructors, real partners — the day-to-day of an FAA Part 141 academy.</p>
      </div>

      <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
        {home.gallery.map(item => (
          <figure class="group relative rounded-lg overflow-hidden border border-slate-200 dark:border-slate-800 aspect-[4/3] bg-slate-100 dark:bg-slate-900">
            <img src={item.image} alt={item.caption} class="w-full h-full object-cover transition duration-500 group-hover:scale-105" loading="lazy" />
            <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent p-4 text-white text-sm font-semibold">{item.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Partners -->
  <section class="bg-slate-50 dark:bg-slate-900 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <div class="text-xs font-semibold tracking-wide text-slate-500 dark:text-slate-400 uppercase">Airline Partners</div>
        <h2 class="mt-2 text-2xl font-bold text-slate-900 dark:text-white">Established pathways to the flight deck</h2>
      </div>
      <div class="mt-10 rounded-2xl bg-white dark:bg-white/95 border border-slate-200 dark:border-slate-800 px-6 sm:px-10 py-8">
        <div class="flex flex-wrap items-center justify-center gap-x-10 sm:gap-x-14 gap-y-8">
          {airlinePartners.map(p => (
            <img src={p.logo} alt={p.name} class="h-10 sm:h-12 w-auto object-contain grayscale opacity-70 hover:grayscale-0 hover:opacity-100 transition duration-300" loading="lazy" />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Reviews -->
  {reviews.length > 0 && (
    <section class="bg-slate-50 dark:bg-slate-900 py-16 sm:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto">
          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 dark:text-white">What our students say.</h2>
        </div>
        <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
          {reviews.map(r => (
            <blockquote class="rounded-xl bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 p-6">
              {r.rating && (
                <div class="text-amber-500 text-lg" aria-label={`${r.rating} out of 5 stars`}>
                  {'★'.repeat(r.rating)}<span class="text-slate-300 dark:text-slate-600">{'★'.repeat(Math.max(0, 5 - r.rating))}</span>
                </div>
              )}
              <p class="mt-3 text-slate-700 dark:text-slate-300 leading-relaxed">“{r.text}”</p>
              <footer class="mt-4 text-sm font-semibold text-slate-900 dark:text-white">
                {r.author}{r.source && <span class="font-normal text-slate-500 dark:text-slate-400"> · via {r.source}</span>}
              </footer>
            </blockquote>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Follow us -->
  {socials.length > 0 && (
    <section class="bg-white dark:bg-slate-950 py-16">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white">See what's happening at DCFA</h2>
        <p class="mt-3 text-slate-600 dark:text-slate-300">Student milestones, fleet updates, and life at the academy.</p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          {socials.map(s => (
            <a href={s.url} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-md border border-slate-300 dark:border-slate-700 px-5 py-3 text-sm font-semibold text-slate-800 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-800 hover:border-slate-400 transition">
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d={s.icon} /></svg>
              {s.label}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Final CTA — full-bleed photographic band that breaks the centered rhythm. -->
  <section class="relative overflow-hidden bg-slate-950 text-white py-24 sm:py-28">
    <div class="absolute inset-0">
      <img src="/images/cockpit/instrument-panel.jpg" alt="" class="w-full h-full object-cover" loading="lazy" />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/95 via-slate-950/85 to-slate-950/80"></div>
    </div>
    <div class="relative mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight">Ready to start?</h2>
      <p class="mt-4 text-lg text-blue-100 dark:text-slate-300">
        A Discovery Flight is the best way to find out if aviation is for you. Take the controls, fly over the Front Range, and decide.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/contact?program=Discovery%20Flight" class="inline-flex items-center rounded-md bg-white text-blue-900 px-6 py-3 text-base font-semibold hover:bg-blue-50 transition">
          Book a Discovery Flight — $150
        </a>
        <a href="tel:+17192087049" class="inline-flex items-center rounded-md border border-blue-300 dark:border-slate-600 px-6 py-3 text-base font-semibold text-white hover:bg-blue-800 dark:hover:bg-slate-800 transition">
          Call (719) 208-7049
        </a>
      </div>
      <p class="mt-6 text-sm text-blue-200 dark:text-slate-400">
        Still have questions? Read our <a href="/faq" class="font-semibold text-white underline hover:text-blue-100">FAQ</a>.
      </p>
    </div>
  </section>
</BaseLayout>
