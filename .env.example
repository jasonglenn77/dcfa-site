# TinaCMS credentials — create a project at https://app.tina.io for this repo,
# then copy these from the project's "Overview" / "Tokens" settings.
# Copy this file to .env (which is gitignored) and fill in the values locally.
# Set the SAME two variables in the Cloudflare build environment for production.

TINA_PUBLIC_CLIENT_ID=
TINA_TOKEN=

# Optional — the branch Tina edits. Defaults to "main" if unset.
# TINA_BRANCH=main

# Web3Forms access key for the contact form (public/safe to expose in the client).
# Get a free key at https://web3forms.com. Set this in .env locally AND as a build
# variable in Cloudflare. Without it the contact form shows a setup notice instead
# of sending. Recipients are configured in the web3forms dashboard, not here.
PUBLIC_WEB3FORMS_KEY=
